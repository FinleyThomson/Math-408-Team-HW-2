import pandas as pd
import sys

def main():
    dist_csv = pd.read_csv("Pairwise Distances.csv")

    distances = dist_csv.iloc[:,1:]
    distances.index = dist_csv.iloc[:,0].values

    start = "The Courts"

    distances = distances.drop(index = start)

    tour = [start]

    print(distances.index[0])

    current_node = start

    while distances.index.empty != True:

        nearest_neighbour = distances[current_node].idxmin()
        distances = distances.drop(index = nearest_neighbour)
        tour.append(nearest_neighbour)
        current_node = nearest_neighbour

    print(tour)

if __name__ == "__main__":
    sys.exit(main())

